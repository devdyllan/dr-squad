# DR Squad — Browser Tools Environment Variables
# Copy this file to tools/browser/.env and fill in the proxy URLs.
# NEVER commit .env to git. This file (.env.example) is safe to commit.
#
# Proxy format: http://USERNAME:PASSWORD@HOST:PORT
# One residential EU proxy per persona. Different IP per alias.
# Recommended providers: IPRoyal (budget), Smartproxy, Bright Data
#
# Each PROXY_CONT_0X maps to exactly one browser profile:
#   PROXY_CONT_01 → BROWSER_META_ADV_01 → FBPRO_ADV_01
#   PROXY_CONT_02 → BROWSER_META_ADV_02 → FBPRO_ADV_02
#   PROXY_CONT_03 → BROWSER_META_ADV_03 → FBPRO_ADV_03
#   PROXY_CONT_04 → BROWSER_META_PAGE_01 → FBPRO_PAGE_01
#   PROXY_CONT_05 → BROWSER_META_PAGE_02 → FBPRO_PAGE_02
#   PROXY_CONT_06 → BROWSER_META_MATRIZ_01 → FBPRO_MATRIZ_01

PROXY_CONT_01=http://user:pass@proxy-host-01:port
PROXY_CONT_02=http://user:pass@proxy-host-02:port
PROXY_CONT_03=http://user:pass@proxy-host-03:port
PROXY_CONT_04=http://user:pass@proxy-host-04:port
PROXY_CONT_05=http://user:pass@proxy-host-05:port
PROXY_CONT_06=http://user:pass@proxy-host-06:port
